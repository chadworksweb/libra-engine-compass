# Libra Engine Compass -- environment. Copy to .env and fill in.

# --- Anthropic (LEC's OWN workspace/key -- per-product cost + blast radius) ---
# Phase 0/1 open item: provision LEC's own Anthropic key. The calibrator tracks
# the LATEST Opus (per Chad 2026-07-11); bump LEC_AGENT_MODEL when a newer Opus
# ships. LEC's difference from RC is meter pricing ($5/$25 Opus), not the model.
LEC_ANTHROPIC_API_KEY=
LEC_AGENT_MODEL=claude-opus-4-8

# Escalation gate (matches RC defaults: Opus everywhere, re-pass off -> the gate
# only records triggers).
LEC_ESCALATION_MODEL=
LEC_ESCALATION_REPASS_ENABLED=false
LEC_ESCALATION_CONFIDENCE_FLOOR=0.6

# --- LEC's own database -------------------------------------------------------
# Local default is a self-contained SQLite file (no infra). Prod points at the
# dedicated libra_engine_compass DB on the shared DO Managed Postgres cluster:
#   postgresql+psycopg://USER:PASS@HOST:25061/lec-pool?sslmode=require
LEC_DATABASE_URL=sqlite:///./data/lec.db

# --- Service-key auth (X-Api-Key on /api/score) -------------------------------
# When false (local/parity default) the scoring endpoint is open. When true,
# callers must present a valid X-Api-Key issued in api_client_keys.
LEC_AUTH_REQUIRED=false

# --- Admin console (obscured login + signed session cookie) -------------------
# The dashboard at /admin is gated behind a secret login URL and an HttpOnly
# signed cookie. ALL FOUR must be set or every admin route 404s (fail-closed).
#   login URL:  https://lec.libraengine.com/lec-admin-<LEC_ADMIN_LOGIN_TOKEN>
#   then sign in with LEC_ADMIN_USERNAME + LEC_ADMIN_PASSWORD.
# Pick an unguessable token, a username, a strong password, and a random 32-byte
# secret (e.g. python -c "import secrets;print(secrets.token_urlsafe(32))").
LEC_ADMIN_LOGIN_TOKEN=
LEC_ADMIN_USERNAME=
LEC_ADMIN_PASSWORD=
LEC_ADMIN_SECRET=
LEC_ADMIN_SESSION_HOURS=12
