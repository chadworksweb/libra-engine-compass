{
  "schema_version": "1.0",
  "ratified_at": "2026-06-08",
  "changelog": [
    {
      "at": "2026-06-09",
      "change": "amend",
      "target": "violet-note-specifics",
      "from_version": "1.0",
      "to_version": "1.1",
      "summary": "Replace the 'different named group' transmit-test with the subject-vs-lens discriminator: the object of the demand (group as destination vs. group as window onto a universal) decides the Elevated cap.",
      "source": "sonnet-arena flag 3 (Indian Reservation, They Don't Care About Us)"
    },
    {
      "at": "2026-06-09",
      "change": "amend",
      "target": "R5",
      "from_version": "1.0",
      "to_version": "1.1",
      "summary": "Add subsection (d): the R5c witness position governs the contamination flag too -- a slur voiced from the victim/attacked position does not set contaminated; only a slur deployed as contempt does.",
      "source": "sonnet-arena flag 5 (They Don't Care About Us)"
    },
    {
      "at": "2026-06-09",
      "change": "amend",
      "target": "CALIBRATION_FORMAT:CONTAMINATION_CHECK",
      "summary": "Add a one-line pointer to R5(d) so the contamination step applies the witness-slur exemption.",
      "source": "sonnet-arena flag 5"
    },
    {
      "at": "2026-06-09",
      "change": "amend",
      "target": "CALIBRATION_FORMAT:CITATION_RULES",
      "summary": "Extend name-redaction to slurs/epithets: refer to them abstractly and note the voicing stance; prevents content-filter blocks on protest/hip-hop/reclamation songs.",
      "source": "sonnet-arena flag 6 (They Don't Care About Us)"
    },
    {
      "at": "2026-06-10",
      "change": "add",
      "target": "CALIBRATION_FORMAT:CHARGE_VALUE",
      "summary": "Add a Charge Anchors section: 15 anonymized reference archetypes (signature + charge) spanning +85 to -92, anchoring the charge_value scale so the number is placed relative to fixed exemplars instead of free-estimated inside a wide band. Cuts within-tier charge variance. Extremes (+95..+100, -95..-100) left unanchored by design. Anchors are content/structure signatures only (no song identity); they never override the anonymous read.",
      "source": "sonnet-arena charge-anchor work (anchored-rating-scale fix #2); negative-tier arena + Chad rulings; mid-blue +55 and the -65/-42 high-orange/self-directed split validated empirically"
    },
    {
      "at": "2026-06-10",
      "change": "amend",
      "target": "CALIBRATION_FORMAT:CASE_FOR_MOVING_DOWN + CONTAMINATION_CHECK",
      "summary": "Discrete-vs-pervasive gate, placed UPSTREAM in the tier-decision step (CASE FOR MOVING DOWN) plus a CONTAMINATION CHECK backstop: a recurring lower-tier payload (especially hook/refrain-carried) is part of the DOMINANT ARC and SETS the tier via R8 cumulative-pattern; it is not an outlier, not atmosphere, and not quarantined to contamination. Weigh co-occurring different down-signals cumulatively, not one-at-a-time-removable. Closes the one-directional sex/substance escape hatch. (v1 lived only in CONTAMINATION CHECK, which runs after the tier is set -> too late; LA CANCION regression stayed green. Moved upstream.)",
      "source": "sonnet-arena flag 7 (LA CANCION, Cha Cha Cha, Titi Me Pregunto); v1 regression-failed, revised upstream"
    },
    {
      "at": "2026-06-11",
      "change": "amend",
      "target": "tiers + CALIBRATION_FORMAT",
      "summary": "Calibrator v3: every tier is assigned to its axis (orange/red = harm, blue/violet = transcendence, green = the neutral zone of both); tenet text unchanged. The read procedure is rewritten (visceral read first, explicit route classification, two-axis read, precedent placement, pole-agnostic intensity vernier, gut-vs-verdict reconciliation), R1-R14 keep their numbers and canonical examples but reorganize into the per-route decision tree, the 15 charge anchors are promoted to the founding precedent table (joined by the -97 deep-red floor ruled 2026-06-11; see tenets/precedents.json), and the model stops naming the tier and the final number: the server composes the charge from components and derives the tier everywhere.",
      "source": "RISING-COMPASS-CALIBRATOR-V3.md (spec + section 5 rulings, 2026-06-11)"
    },
    {
      "at": "2026-06-18",
      "change": "add",
      "target": "R15",
      "summary": "Add R15, the reverence-halo / cultural-sanctity strip: a state-sanctioned, patriotic, memorial, civic-ritual, or institutional sanctity (fallen soldiers, the flag, a sacred site, a martyr, a hallowed tradition) is an inherited frame the lyrics must earn on the page, not pre-loaded charge. The civic and institutional generalization of R14's religious reverence-halo, and the same error class as R3 (sacred vocabulary is not substance), R6 (reputation the audience supplies), and R12 (era reverence the listener back-fills). Procedure: separate what the song asserts (the cause was just, the place is holy) from what it delivers (fidelity, consolation, witness); only the delivered content scores, and unexamined valorization dilutes rather than elevates. Strip-test: remove the sacred wrapper and score what survives.",
      "source": "Daily Downloads 2026-06-18, 'The Twenty-One Steps' (PayTreeIt, Tomb of the Unknown Soldier), violet/+83 -> blue/+72 -> blue/+37 across two Chad corrections"
    }
  ],
